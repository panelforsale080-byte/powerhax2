<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/loader_background">

    <ScrollView
        android:id="@+id/main_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingTop="18dp"
            android:paddingEnd="14dp"
            android:paddingBottom="56dp">

            <ImageView
                android:id="@+id/app_banner"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:contentDescription="Accel mark"
                android:src="@drawable/accel_mark" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/pixel"
                android:text="AccelLoader"
                android:textColor="@color/loader_text_primary"
                android:textSize="8sp" />

            <TextView
                android:id="@+id/owner_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/pixel"
                android:text="Owner Xorel"
                android:textColor="@color/loader_text_muted"
                android:textSize="6sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/loader_card"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="12dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/library_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/pixel"
                        android:text="CODM"
                        android:textColor="@color/loader_text_primary"
                        android:textSize="7sp" />

                    <TextView
                        android:id="@+id/library_game"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="Call of Duty Mobile"
                        android:textColor="@color/loader_text_secondary"
                        android:textSize="9sp" />

                    <TextView
                        android:id="@+id/library_version"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="@font/pixel"
                        android:text="1.6.59"
                        android:textColor="@color/loader_text_muted"
                        android:textSize="6sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/library_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/accel_chip"
                    android:fontFamily="@font/pixel"
                    android:paddingStart="8dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="4dp"
                    android:text="idle"
                    android:textColor="@color/loader_status_active"
                    android:textSize="6sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/loader_card"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/pixel"
                    android:text="library"
                    android:textColor="@color/loader_text_muted"
                    android:textSize="6sp" />

                <TextView
                    android:id="@+id/library_download_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFamily="@font/pixel"
                    android:text="waiting…"
                    android:textColor="@color/loader_text_primary"
                    android:textSize="7sp" />

                <ProgressBar
                    android:id="@+id/library_download_progress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="4dp"
                    android:layout_marginTop="8dp"
                    android:max="100"
                    android:progress="0"
                    android:progressBackgroundTint="#44FFFFFF"
                    android:progressTint="@color/loader_text_primary"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/library_package"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="@font/pixel"
                    android:text="module pending"
                    android:textColor="@color/loader_text_secondary"
                    android:textSize="6sp" />

                <TextView
                    android:id="@+id/inject_method_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:fontFamily="@font/pixel"
                    android:text="method 1"
                    android:textColor="@color/loader_text_muted"
                    android:textSize="6sp" />

                <TextView
                    android:id="@+id/inject_log"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/accel_chip"
                    android:fontFamily="@font/pixel"
                    android:maxLines="4"
                    android:padding="8dp"
                    android:text="—"
                    android:textColor="@color/loader_text_secondary"
                    android:textSize="6sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/login_button"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:layout_marginTop="12dp"
                    android:fontFamily="@font/pixel"
                    android:text="LOAD"
                    android:textColor="#2A2A2A"
                    android:textSize="7sp"
                    app:backgroundTint="#E8E8E8"
                    app:cornerRadius="8dp"
                    app:strokeWidth="0dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/telegram_button"
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:layout_marginTop="8dp"
                    android:fontFamily="@font/pixel"
                    android:text="@axcelLOki"
                    android:textColor="@color/loader_text_primary"
                    android:textSize="6sp"
                    app:backgroundTint="#33000000"
                    app:cornerRadius="8dp"
                    app:icon="@drawable/ic_telegram"
                    app:iconGravity="textStart"
                    app:iconSize="14dp"
                    app:iconTint="@color/loader_text_primary"
                    app:strokeColor="@color/loader_border"
                    app:strokeWidth="1dp" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/library_menu_button"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone"
                android:contentDescription="hidden" />

            <Spinner android:id="@+id/my_spinner" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
            <Spinner android:id="@+id/delay_spinner" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
            <Spinner android:id="@+id/method_spinner" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
            <ProgressBar android:id="@+id/progressBar" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
            <RadioGroup android:id="@+id/radioGroup" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone">
                <RadioButton android:id="@+id/radio_auto" android:layout_width="0dp" android:layout_height="0dp" android:checked="true" />
                <RadioButton android:id="@+id/radio_manual" android:layout_width="0dp" android:layout_height="0dp" />
            </RadioGroup>
            <TextView android:id="@+id/root_status" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
            <ScrollView android:id="@+id/inject_log_scroll" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone">
                <TextView android:layout_width="0dp" android:layout_height="0dp" />
            </ScrollView>
            <TextView android:id="@+id/license_key_label" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
            <com.google.android.material.textfield.TextInputLayout android:id="@+id/input_layout" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/input_key" android:layout_width="0dp" android:layout_height="0dp" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>
    </ScrollView>

    <TextView
        android:id="@+id/powered_by"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="8dp"
        android:fontFamily="@font/pixel"
        android:text="Owner Xorel"
        android:textColor="@color/loader_text_muted"
        android:textSize="6sp" />

    <View
        android:id="@+id/drawer_scrim"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

    <FrameLayout
        android:id="@+id/library_drawer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone">
        <EditText android:id="@+id/library_search" android:layout_width="0dp" android:layout_height="0dp" />
        <TextView android:id="@+id/library_count" android:layout_width="0dp" android:layout_height="0dp" />
        <LinearLayout android:id="@+id/library_list" android:layout_width="0dp" android:layout_height="0dp" android:orientation="vertical" />
        <ImageButton android:id="@+id/drawer_close" android:layout_width="0dp" android:layout_height="0dp" />
        <LinearLayout android:id="@+id/drawer_about" android:layout_width="0dp" android:layout_height="0dp" android:orientation="vertical" />
    </FrameLayout>
</FrameLayout>