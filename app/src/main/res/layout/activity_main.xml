<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_main_gradient">

    <ScrollView
        android:id="@+id/main_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="48dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="20dp"
            android:paddingEnd="16dp"
            android:paddingBottom="12dp">

            <LinearLayout
                android:id="@+id/card_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/accel_card_elevated"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="14dp">

                <ImageView
                    android:id="@+id/app_banner"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:contentDescription="Accel"
                    android:src="@drawable/accel_mark" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/pixel"
                        android:letterSpacing="0.14"
                        android:text="Accel"
                        android:textColor="@color/loader_text_primary"
                        android:textSize="9sp" />

                    <TextView
                        android:id="@+id/owner_label"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Owner Xorel"
                        android:textColor="@color/loader_text_muted"
                        android:textSize="8sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/header_build"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/accel_chip"
                    android:fontFamily="@font/pixel"
                    android:paddingStart="8dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="4dp"
                    android:text="v1.0"
                    android:textColor="@color/loader_text_secondary"
                    android:textSize="7sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/card_profile"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/accel_card_elevated"
                android:orientation="vertical"
                android:padding="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/pixel"
                        android:letterSpacing="0.12"
                        android:text="game profile"
                        android:textColor="@color/loader_text_muted"
                        android:textSize="7sp" />

                    <TextView
                        android:id="@+id/library_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/accel_chip"
                        android:fontFamily="@font/pixel"
                        android:paddingStart="8dp"
                        android:paddingTop="3dp"
                        android:paddingEnd="8dp"
                        android:paddingBottom="3dp"
                        android:text="idle"
                        android:textColor="@color/loader_status_active"
                        android:textSize="6sp" />
                </LinearLayout>

                <TableLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:stretchColumns="1">

                    <TableRow android:paddingTop="3dp" android:paddingBottom="3dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="title"
                            android:textColor="@color/loader_text_muted"
                            android:textSize="8sp" />
                        <TextView
                            android:id="@+id/library_name"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="end"
                            android:text="CODM"
                            android:textColor="@color/loader_text_primary"
                            android:textSize="8sp" />
                    </TableRow>

                    <TableRow android:paddingTop="3dp" android:paddingBottom="3dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="game"
                            android:textColor="@color/loader_text_muted"
                            android:textSize="8sp" />
                        <TextView
                            android:id="@+id/library_game"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="end"
                            android:text="Call of Duty Mobile"
                            android:textColor="@color/loader_text_secondary"
                            android:textSize="8sp" />
                    </TableRow>

                    <TableRow android:paddingTop="3dp" android:paddingBottom="3dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="version"
                            android:textColor="@color/loader_text_muted"
                            android:textSize="8sp" />
                        <TextView
                            android:id="@+id/library_version"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="end"
                            android:fontFamily="@font/pixel"
                            android:text="1.6.59"
                            android:textColor="@color/loader_text_primary"
                            android:textSize="8sp" />
                    </TableRow>

                    <TableRow android:paddingTop="3dp" android:paddingBottom="3dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="module"
                            android:textColor="@color/loader_text_muted"
                            android:textSize="8sp" />
                        <TextView
                            android:id="@+id/library_package"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="end"
                            android:text="pending"
                            android:textColor="@color/loader_text_secondary"
                            android:textSize="8sp" />
                    </TableRow>
                </TableLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/card_module"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/accel_card_elevated"
                android:orientation="vertical"
                android:padding="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/pixel"
                        android:text="module download"
                        android:textColor="@color/loader_text_muted"
                        android:textSize="7sp" />

                    <TextView
                        android:id="@+id/library_download_percent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/pixel"
                        android:text="0%"
                        android:textColor="@color/loader_text_primary"
                        android:textSize="8sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/module_update_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/feature_tile"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="10dp"
                    android:paddingTop="8dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="8dp"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/module_update_text"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="New module. The saved copy was removed."
                        android:textColor="@color/loader_text_primary"
                        android:textSize="8sp" />

                    <TextView
                        android:id="@+id/module_update_action"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/accel_chip"
                        android:fontFamily="@font/pixel"
                        android:paddingStart="8dp"
                        android:paddingTop="4dp"
                        android:paddingEnd="8dp"
                        android:paddingBottom="4dp"
                        android:text="download"
                        android:textColor="@color/loader_status_maintenance"
                        android:textSize="7sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/library_download_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="waiting…"
                    android:textColor="@color/loader_text_primary"
                    android:textSize="9sp" />

                <ProgressBar
                    android:id="@+id/library_download_progress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="8dp"
                    android:layout_marginTop="10dp"
                    android:indeterminate="false"
                    android:max="100"
                    android:progress="0"
                    android:progressDrawable="@drawable/progress_download"
                    android:visibility="gone" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/feature_tile"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/pixel"
                        android:text="delay"
                        android:textColor="@color/loader_text_muted"
                        android:textSize="6sp" />

                    <Spinner
                        android:id="@+id/delay_spinner"
                        android:layout_width="match_parent"
                        android:layout_height="36dp"
                        android:layout_marginTop="2dp"
                        android:background="@android:color/transparent"
                        android:popupBackground="@color/loader_surface_alt" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/feature_tile"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="10dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/pixel"
                        android:text="root"
                        android:textColor="@color/loader_text_muted"
                        android:textSize="6sp" />

                    <TextView
                        android:id="@+id/root_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="checking…"
                        android:textColor="@color/loader_text_secondary"
                        android:textSize="8sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/inject_log"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/feature_tile"
                    android:fontFamily="@font/pixel"
                    android:maxLines="4"
                    android:padding="10dp"
                    android:text="—"
                    android:textColor="@color/loader_text_secondary"
                    android:textSize="7sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/login_button"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="14dp"
                    android:fontFamily="@font/pixel"
                    android:text="LOAD"
                    android:textColor="@color/loader_background_deep"
                    android:textSize="9sp"
                    app:backgroundTint="@color/loader_accent"
                    app:cornerRadius="12dp"
                    app:strokeWidth="0dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/telegram_button"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="8dp"
                    android:text="@axcelLOki"
                    android:textColor="@color/loader_text_primary"
                    android:textSize="8sp"
                    app:cornerRadius="12dp"
                    app:icon="@drawable/ic_telegram"
                    app:iconGravity="textStart"
                    app:iconSize="18dp"
                    app:iconTint="@color/loader_text_primary"
                    app:strokeColor="@color/loader_border"
                    app:strokeWidth="1dp" />
            </LinearLayout>

            <Spinner
                android:id="@+id/my_spinner"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />

            <Spinner
                android:id="@+id/method_spinner"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />

            <ProgressBar
                android:id="@+id/progressBar"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />

            <RadioGroup
                android:id="@+id/radioGroup"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone">

                <RadioButton
                    android:id="@+id/radio_auto"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:checked="true" />

                <RadioButton
                    android:id="@+id/radio_manual"
                    android:layout_width="0dp"
                    android:layout_height="0dp" />
            </RadioGroup>

            <ScrollView
                android:id="@+id/inject_log_scroll"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="0dp" />
            </ScrollView>

            <TextView
                android:id="@+id/license_key_label"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/input_layout"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/input_key"
                    android:layout_width="0dp"
                    android:layout_height="0dp" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>
    </ScrollView>

    <TextView
        android:id="@+id/powered_by"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="#CC0A0A0A"
        android:gravity="center"
        android:paddingTop="8dp"
        android:paddingBottom="10dp"
        android:text="Owner Xorel"
        android:textColor="@color/loader_text_muted"
        android:textSize="9sp" />

    <View
        android:id="@+id/drawer_scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/loader_scrim"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/library_drawer"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:elevation="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:translationX="268dp">

        <TextView
            android:id="@+id/library_menu_button"
            android:layout_width="32dp"
            android:layout_height="92dp"
            android:background="@drawable/edge_tab"
            android:clickable="true"
            android:contentDescription="Libraries"
            android:focusable="true"
            android:fontFamily="@font/pixel"
            android:gravity="center"
            android:text="l\ni\nb\ns"
            android:textColor="@color/loader_text_primary"
            android:textSize="8sp" />

        <LinearLayout
            android:id="@+id/library_panel"
            android:layout_width="268dp"
            android:layout_height="match_parent"
            android:background="@drawable/drawer_panel_right"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingTop="28dp"
            android:paddingEnd="14dp"
            android:paddingBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/pixel"
                        android:text="libraries"
                        android:textColor="@color/loader_text_primary"
                        android:textSize="9sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="CODM files on GitHub"
                        android:textColor="@color/loader_text_muted"
                        android:textSize="8sp" />
                </LinearLayout>

                <ImageButton
                    android:id="@+id/drawer_close"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@android:color/transparent"
                    android:contentDescription="Close libraries"
                    android:padding="8dp"
                    android:src="@drawable/ic_close" />
            </LinearLayout>

            <EditText
                android:id="@+id/library_search"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/search_box"
                android:drawableStart="@drawable/ic_search"
                android:drawablePadding="8dp"
                android:hint="Search"
                android:importantForAutofill="no"
                android:inputType="text"
                android:maxLines="1"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:textColor="@color/loader_text_primary"
                android:textColorHint="@color/loader_text_muted"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/library_count"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:fontFamily="@font/pixel"
                android:text="libraries"
                android:textColor="@color/loader_text_muted"
                android:textSize="7sp" />

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="8dp"
                android:layout_weight="1"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/library_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </ScrollView>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="10dp"
                android:background="@color/loader_border" />

            <LinearLayout
                android:id="@+id/drawer_about"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:paddingStart="2dp"
                android:paddingEnd="2dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:contentDescription="About"
                    android:src="@drawable/ic_about" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:text="About"
                    android:textColor="@color/loader_text_secondary"
                    android:textSize="11sp" />

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:contentDescription="Open about"
                    android:src="@drawable/ic_chevron_right" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>